{{!
    @template auth_moowoodle/progress

    Setup wizard step progress navigation, styled like Moodle's secondary
    navigation tabs (the "moremenu" component).

    Context variables required for this template:
    * items - array of {label, url, active, disabled}, one per wizard step.
      A locked step (not yet reached) has disabled=true and no url.

    Example context (json):
    {
        "items": [
            {"label": "General", "url": "https://example.com/step1", "active": true, "disabled": false},
            {"label": "Web Service", "url": null, "active": false, "disabled": true}
        ]
    }
}}
<nav>
    <ul class="nav more-nav nav-tabs moremenu navigation observed" role="menubar">
        {{#items}}
        <li class="nav-item" role="none">
            {{#disabled}}
            <span class="nav-link disabled" aria-disabled="true">{{label}}</span>
            {{/disabled}}
            {{^disabled}}
            <a href="{{url}}" class="nav-link{{#active}} active{{/active}}" role="menuitem"{{#active}} aria-current="true"{{/active}}>{{label}}</a>
            {{/disabled}}
        </li>
        {{/items}}
    </ul>
</nav>
